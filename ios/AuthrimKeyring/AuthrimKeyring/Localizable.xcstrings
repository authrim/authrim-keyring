    "The algorithm “%@” is not supported." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アルゴリズム「%@」には対応していません。"
          }
        }
      }
    },
    "The backup file contains the secret keys of all your accounts, encrypted with the password you set here. Keep the file and the password in separate places." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
