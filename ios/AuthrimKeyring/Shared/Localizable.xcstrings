          }
        }
      }
    },
    "The backup file contains the secret keys and recovery codes of all your accounts, encrypted with the password you set here. Keep the file and the password in separate places." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップファイルには、すべてのアカウントの秘密鍵とリカバリーコードが、ここで設定するパスワードで暗号化されて含まれます。ファイルとパスワードは別々の場所に保管してください。"
          }
