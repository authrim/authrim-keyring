    },
    "Save": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "Scan the QR code shown when you turn on two-factor authentication for a service.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービスで2段階認証を有効にするときに表示されるQRコードを読み取ってください。"
          }
        }
      }
    },
    "Search accounts": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを検索"
          }
        }
      }
    },
    "Secret keys are stored only in this device’s Keychain. They are never sent to a server or synced with iCloud, and they do not move to a new device. If you change or lose this device, you will need to set up two-factor authentication again for each service, so keep the backup codes each service provides.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秘密鍵はこのデバイスのキーチェーンにのみ保存されます。サーバーへの送信やiCloudとの同期は行わず、新しいデバイスにも移行されません。機種変更や紛失の際は各サービスで2段階認証を設定し直す必要があるため、各サービスが発行するバックアップコードを保管してください。"
          }
        }
      }
    },
    "Security": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティ"
          }
        }
      }
    },
