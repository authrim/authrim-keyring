<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeyringAppGroup</key>
	<string>$(KEYRING_APP_GROUP)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.authrim.keyring.credential-offer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>openid-credential-offer</string>
				<string>haip-vci</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.authrim.keyring.presentation-request</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>openid4vp</string>
				<string>haip-vp</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.authrim.keyring.authorization-callback</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.authrim.keyring</string>
			</array>
		</dict>
	</array>
	<key>WalletProviderKind</key>
	<string>$(WALLET_PROVIDER_KIND)</string>
	<key>WalletProviderOrigin</key>
	<string>$(WALLET_PROVIDER_ORIGIN)</string>
	<key>WalletProviderIssuer</key>
	<string>$(WALLET_PROVIDER_ISSUER)</string>
	<key>WalletProviderPinnedRoots</key>
	<array>
		<string>$(WALLET_PROVIDER_ROOT_1)</string>
		<string>$(WALLET_PROVIDER_ROOT_2)</string>
	</array>
	<key>WalletProviderIssuers</key>
	<array>
		<string>$(WALLET_CREDENTIAL_ISSUER_1)</string>
		<string>$(WALLET_CREDENTIAL_ISSUER_2)</string>
	</array>
	<key>WalletClientID</key>
	<string>$(WALLET_CLIENT_ID)</string>
	<key>WalletRedirectURI</key>
	<string>$(WALLET_REDIRECT_URI)</string>
	<key>AuthrimTrustedRoots</key>
	<array>
		<string>$(AUTHRIM_ROOT_1)</string>
		<string>$(AUTHRIM_ROOT_2)</string>
	</array>
	<key>AuthrimConsoleHosts</key>
	<array>
		<string>$(AUTHRIM_CONSOLE_HOST_1)</string>
	</array>
	<key>NSUserActivityTypes</key>
	<array>
		<string>ASCredentialExchangeActivity</string>
	</array>
</dict>
</plist>
