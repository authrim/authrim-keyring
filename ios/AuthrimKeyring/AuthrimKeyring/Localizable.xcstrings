        }
      }
    },
    "A backup file is protected by a password you choose and can be restored on any device, even without iCloud." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップファイルは自分で決めたパスワードで保護され、iCloudがなくてもどのデバイスにでも復元できます。"
          }
        }
      }
    },
    "A camera is not available on this device." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
