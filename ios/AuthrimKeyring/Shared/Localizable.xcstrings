      }
    },
    "The Secure Key Could Not Be Used" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セキュアな鍵を使用できません"
          }
        }
      }
    },
    "The setup code does not contain a secret key." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セットアップコードに秘密鍵が含まれていません。"
          }
        }
      }
    },
    "The setup key can contain only the letters A–Z and the digits 2–7." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セットアップキーに使えるのは、英字A〜Zと数字2〜7だけです。"
          }
        }
      }
    },
    "The site asked for a kind of passkey Keyring cannot create." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサイトが求める種類のパスキーは、Keyringでは作成できません。"
          }
        }
      }
    },
    "The transaction code was wrong or the offer has expired. Create a new offer in the admin console and scan it again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トランザクションコードが誤っているか、オファーの有効期限が切れています。管理コンソールで新しいオファーを作成し、もう一度読み取ってください。"
          }
        }
      }
    },
    "These codes come from different transfers. Start over and use the codes of a single transfer." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのコードは別々の移行のものです。最初からやり直し、ひとつの移行のコードだけを使ってください。"
          }
        }
      }
    },
    "They are also removed from iCloud Keychain and from your other devices that use sync. You will no longer be able to generate codes for these services. Make sure you have another way to sign in. This cannot be undone." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudキーチェーンと、同期を使っているほかのデバイスからも削除されます。これらのサービスのコードを生成できなくなります。別のサインイン手段があることを確認してください。この操作は取り消せません。"
          }
        }
      }
    },
    "This %@ export is encrypted. Export it again without encryption, import it, then delete the file." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この%@の書き出しファイルは暗号化されています。暗号化せずに書き出し直して取り込み、そのあとファイルを削除してください。"
          }
        }
      }
    },
    "This account has already been added." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアカウントはすでに追加されています。"
          }
        }
      }
    },
    "This backup was made by a newer version of Keyring. Update the app and try again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバックアップは新しいバージョンのKeyringで作成されています。アプリをアップデートしてからもう一度お試しください。"
          }
        }
      }
    },
    "This card could not be read from the Keychain. Try again after restarting the app." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このカードをキーチェーンから読み込めませんでした。アプリを再起動してからもう一度お試しください。"
          }
        }
      }
    },
    "This code is from a different transfer. Tap Start Over to scan a new transfer." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコードは別の移行のものです。新しい移行を読み取るには「最初から」をタップしてください。"
          }
        }
      }
    },
    "This device’s key for the credential is deleted, so it can no longer be presented. Also revoke it in the admin console. This cannot be undone." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この資格情報用のこのデバイス上の鍵が削除されるため、資格情報を提示できなくなります。管理コンソールでも失効させてください。この操作は取り消せません。"
          }
        }
      }
    },
    "This file is not a Keyring backup." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルはKeyringのバックアップではありません。"
          }
        }
      }
    },
    "This file is not an export Keyring can read." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルは、Keyringで読み込める書き出しファイルではありません。"
          }
        }
      }
    },
    "This iPhone Only" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneだけ"
          }
        }
      }
    },
