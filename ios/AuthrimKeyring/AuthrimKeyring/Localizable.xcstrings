    "Changing the name does not affect the codes.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を変更してもコードは変わりません。"
          }
        }
      }
    },
    "Check that the service matches the site where you are turning on two-factor authentication.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2段階認証を設定しているサイトと、サービス名が一致しているか確認してください。"
