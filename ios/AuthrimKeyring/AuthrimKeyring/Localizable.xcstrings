    "Allow camera access in Settings to scan QR codes.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードを読み取るには、設定でカメラへのアクセスを許可してください。"
          }
        }
      }
    },
    "Ask for %@ or your passcode each time the app is opened.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを開くたびに%@またはパスコードを要求します。"
          }
        }
      }
    },
