    },
    "The passwords do not match." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードが一致しません。"
          }
        }
      }
    },
    "The photo could not be loaded." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真を読み込めませんでした。"
          }
        }
      }
    },
    "The photo stays on this device. It is not included in iCloud sync or Keyring backups." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真はこのデバイスにだけ保存され、iCloud同期やKeyringのバックアップには含まれません。"
          }
        }
      }
    },
    "The secret key is not valid Base32." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
