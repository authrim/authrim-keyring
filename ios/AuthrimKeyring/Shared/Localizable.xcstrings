{
  "sourceLanguage" : "en",
  "strings" : {
    "“%@” codes are not supported. Only time-based (TOTP) codes can be added." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」コードには対応していません。追加できるのは時間ベース（TOTP）のコードだけです。"
          }
        }
      }
    },
    "%@-digit codes are not supported." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
