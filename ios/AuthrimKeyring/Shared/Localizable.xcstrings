    "The file is too large." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルが大きすぎます。"
          }
        }
      }
    },
    "The issued credential failed verification, so it was not saved. Create a new offer in the admin console and scan it again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "発行された資格情報の検証に失敗したため、保存されませんでした。管理コンソールで新しいオファーを作成し、もう一度読み取ってください。"
          }
        }
      }
    },
    "The Issuer Could Not Be Verified" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "発行元を確認できません"
          }
        }
      }
    },
    "The issuer’s information is inconsistent, so Keyring stopped. Nothing was saved. Create a new offer or contact your administrator." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "発行元の情報に矛盾があるため、Keyringは処理を中止しました。何も保存されていません。新しいオファーを作成するか、管理者に連絡してください。"
          }
        }
      }
    },
    "The Offer Was Rejected" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オファーが拒否されました"
          }
        }
      }
    },
    "The other app sent no one-time codes or passkeys." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのアプリからワンタイムコードもパスキーも送られてきませんでした。"
          }
        }
      }
    },
    "The passkey is kept on this iPhone for now and moves to iCloud Keychain if you turn on iCloud sync." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このパスキーは今はこのiPhoneに保存し、iCloud同期をオンにするとiCloudキーチェーンに移ります。"
          }
        }
      }
    },
    "The passkey is synced to your other devices through iCloud Keychain, end-to-end encrypted." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このパスキーはiCloudキーチェーンで、エンドツーエンドで暗号化されてほかのデバイスと同期します。"
          }
        }
      }
    },
    "The password is incorrect, or the file is damaged." : {
      "localizations" : {
