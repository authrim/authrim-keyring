      }
    },
    "Make sure two-factor authentication is turned off for this account or that you have another way to sign in. This cannot be undone.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントの2段階認証を解除済みか、別のサインイン手段があることを確認してください。この操作は取り消せません。"
          }
        }
      }
    },
    "Mint": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミント"
          }
        }
      }
    },
    "Moss": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モス"
          }
        }
      }
    },
    "Most services use SHA1, 6 digits and 30 seconds. Change these only if the service tells you to.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほとんどのサービスはSHA1・6桁・30秒です。サービスから指示があった場合だけ変更してください。"
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前"
          }
        }
      }
    },
    "No Accounts": {
