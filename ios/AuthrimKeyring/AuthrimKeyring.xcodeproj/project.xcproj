{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "ja",
    ],
  },
  "files": [
    { "kind": "folder", "path": "AuthrimKeyring", "target-membership": [ "AuthrimKeyring" ] },
    { "kind": "folder", "path": "Shared", "target-membership": [ "AuthrimKeyring", "KeyringAutoFill" ] },
    { "kind": "folder", "path": "KeyringAutoFill", "target-membership": [ "KeyringAutoFill" ] },
    { "kind": "folder", "path": "AuthrimKeyringTests", "target-membership": [ "AuthrimKeyringTests" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/AuthrimKeyring.app", "id": "000000000000000000000120", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/KeyringAutoFill.appex", "id": "000000000000000000000121", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "AuthrimKeyring/copy/Embed Foundation Extensions", "code-sign-on-copy": true } ] },
        { "path": "<PRODUCTS>/AuthrimKeyringTests.xctest", "id": "000000000000000000000122", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "AuthrimKeyring",
      "id": "000000000000000100000000",
      "product": "Products/AuthrimKeyring.app",
      "product-type": "application",
      "dependencies": [
        "KeyringAutoFill",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "Config/AuthrimKeyring.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "2",
        "DEVELOPMENT_TEAM": "BQ23XXWDX8",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Config/AuthrimKeyring-Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Keyring",
        "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "NO",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.utilities",
        "INFOPLIST_KEY_NSCameraUsageDescription": "The camera is used to scan two-factor authentication and credential QR codes.",
        "INFOPLIST_KEY_NSFaceIDUsageDescription": "Face ID is used to unlock Authrim Keyring when the app lock is on.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UILaunchStoryboardName": "LaunchScreen",
        "INFOPLIST_KEY_UIStatusBarStyle[sdk=iphoneos*]": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UIStatusBarStyle[sdk=iphonesimulator*]": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait",
        "IPHONEOS_DEPLOYMENT_TARGET": "17.0",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/Frameworks",
        "MARKETING_VERSION": "1.2",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.authrim.keyring",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "iphoneos",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1",
      },
    }, {
      "name": "KeyringAutoFill",
      "id": "000000000000000200000000",
      "product": "Products/KeyringAutoFill.appex",
