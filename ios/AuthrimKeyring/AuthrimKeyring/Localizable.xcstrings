{
  "sourceLanguage": "en",
  "strings": {
    "%@-digit codes are not supported.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@桁のコードには対応していません。"
          }
        }
      }
    },
